# WhatsApp / Baileys
BOT_NAME=Bot de Reportes
BOT_PREFIX=.
LOG_LEVEL=info

# JID de grupo o chat privado de moderación. Ejemplo: 1234567890-1234567890@g.us
MODERATION_JID=

# Números de administradores separados por comas, en formato internacional sin +.
ADMIN_NUMBERS=

# Canal humano de soporte que aparecerá en .soporte
SUPPORT_URL=https://example.com/soporte
SUPPORT_EMAIL=soporte@example.com

# Límites de seguridad
REPORT_COOLDOWN_SECONDS=60
MAX_LOOP_ITERATIONS=5
LOOP_COOLDOWN_SECONDS=300
DATA_FILE=./data/bot-data.json
